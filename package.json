{
  "name": "synapse-term",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first desktop terminal for user-managed sessions.",
  "author": "huangzy",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter @synapse-term/desktop build",
    "dev": "pnpm --filter @synapse-term/desktop dev",
    "start": "pnpm --filter @synapse-term/desktop start",
    "format": "prettier --write \"apps/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"scripts/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"docs/**/*.{md,json,yml}\" \"*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"scripts/**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\" \"docs/**/*.{md,json,yml}\" \"*.{js,mjs,cjs,ts,tsx,json,css,md,yml}\"",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "package:win": "pnpm build && electron-builder --config electron-builder.yml --win nsis --publish never",
    "package:win:dir": "pnpm build && electron-builder --config electron-builder.yml --win dir --publish never",
    "package:mac": "pnpm build && electron-builder --config electron-builder.yml --mac dmg --publish never",
    "package:mac:dir": "pnpm build && electron-builder --config electron-builder.yml --mac dir --publish never",
    "smoke:packaged-desktop": "node scripts/smoke-packaged-desktop.mjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer-lifecycle.ps1",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
