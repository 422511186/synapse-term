{
  "name": "@synapse-term/desktop",
  "version": "0.5.1",
  "private": true,
  "description": "Synapse Term desktop shell",
  "author": "huangzy",
  "type": "module",
  "main": "dist/main/electron-main.mjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite --config vite.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@synapse-term/mcp-runtime": "workspace:*",
    "@synapse-term/session-runtime": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "0.487.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@synapse-term/test-kit": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "vite": "^8.1.5"
  }
}
